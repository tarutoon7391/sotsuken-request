# ---- 卒研リポジトリ ----
# Issue を作る先。owner/repo の形式
TARGET_REPO=tarutoon7391/Sotsuken
# 卒研リポジトリ限定の fine-grained personal access token
# 権限：Issues(Read and write)・Contents(Read and write)・Pull requests(Read and write)・Metadata(Read)
GITHUB_TOKEN=github_pat_xxxxxxxx

# ---- GitHub OAuth App（ログイン用）----
GITHUB_CLIENT_ID=Iv1.xxxxxxxx
GITHUB_CLIENT_SECRET=xxxxxxxx
# OAuth App に登録した Authorization callback URL と完全一致させる
OAUTH_CALLBACK_URL=http://localhost:3100/auth/github/callback

# ---- サイト ----
# Cookie 署名用。長いランダム文字列（例：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"）
SESSION_SECRET=change-me-to-a-long-random-string
PORT=3100
# 1ユーザーが1日に送れる件数。0 なら無制限
DAILY_LIMIT=0
# 本番では production にする（Cookie が Secure になる）
NODE_ENV=development
# 開発用：GitHub ログインを省略して指定ユーザーとして扱う（NODE_ENV=production では無視される）
# DEV_FAKE_LOGIN=tarutoon7391
