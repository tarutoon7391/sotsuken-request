<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | 修正要望サイト</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <header class="topbar">
    <a class="brand" href="/">卒研 修正要望サイト</a>
    <nav>
      <% if (user) { %>
        <a href="/">要望を送る</a>
        <a href="/requests">一覧</a>
        <span class="who">
          <% if (user.avatar) { %><img class="avatar" src="<%= user.avatar %>" alt=""><% } %>
          @<%= user.login %>
        </span>
        <form method="post" action="/logout" class="inline"><button class="link" type="submit">ログアウト</button></form>
      <% } %>
    </nav>
  </header>
  <main class="container">
